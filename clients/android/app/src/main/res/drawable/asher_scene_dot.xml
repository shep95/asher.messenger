<?xml version="1.0" encoding="utf-8"?>
<!-- Asher scene indicator dot: a 6dp core with a soft 8dp glow of the same colour (tinted at runtime). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/scene_indicator_glow">
        <shape android:shape="oval">
            <size
                android:width="14dp"
                android:height="14dp" />
            <solid android:color="@color/asher_scene_offline" />
        </shape>
    </item>
    <item
        android:id="@+id/scene_indicator_core"
        android:bottom="4dp"
        android:end="4dp"
        android:left="4dp"
        android:right="4dp"
        android:start="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <size
                android:width="6dp"
                android:height="6dp" />
            <solid android:color="@color/asher_scene_offline" />
        </shape>
    </item>
</layer-list>
