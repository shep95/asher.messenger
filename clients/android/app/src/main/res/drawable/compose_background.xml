<?xml version="1.0" encoding="utf-8"?>
<!-- Asher composer: a pill on the raised surface with a 1dp border. -->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid
        android:color="@color/asher_composer_fill" />

    <stroke
        android:width="1dp"
        android:color="@color/asher_composer_border" />

    <corners
        android:radius="26dp" />

</shape>
