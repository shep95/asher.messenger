{
  "$schema": "asher-design-tokens/1",
  "name": "Asher",
  "mood": "Earth seen from orbit: a black void, a thin blue atmosphere lit from one side, cloud white, one small craft. Calm, vast, precise.",
  "wallpaper": {
    "file": "brands/asher/design/earth.webp",
    "alt": "Earth from low orbit with a small spacecraft at the terminator",
    "overlay": "linear-gradient(180deg, rgba(5,7,11,0.35) 0%, rgba(5,7,11,0.65) 100%)",
    "position": "center right",
    "size": "cover",
    "note": "Source is 960x540; supply a 2560x1440 master for production builds at the same path."
  },
  "color": {
    "void": "#05070B",
    "space": "#080C13",
    "surface": "#0B1017",
    "surface-raised": "#111823",
    "surface-overlay": "#16202D",
    "border": "#1B2533",
    "border-strong": "#27344A",
    "atmosphere": "#3D8FCF",
    "atmosphere-hover": "#5AA7E0",
    "atmosphere-pressed": "#2E74AB",
    "atmosphere-soft": "#1E466B",
    "rim": "#CFE6F7",
    "cloud": "#E8EEF4",
    "text": "#E8EEF4",
    "text-secondary": "#9BB0C3",
    "text-muted": "#5F7387",
    "text-on-atmosphere": "#F4F9FD",
    "terrain": "#8A8F73",
    "success": "#4FBF9F",
    "warning": "#E0B45A",
    "danger": "#E06B6B",
    "bubble-out-start": "#2A6FA8",
    "bubble-out-end": "#1F5686",
    "bubble-in": "#131C28",
    "bubble-in-border": "#1E2A3A",
    "presence-online": "#5AA7E0",
    "presence-away": "#CFE6F7",
    "presence-offline": "#5F7387",
    "presence-mesh": "#4FBF9F",
    "presence-carrying": "#E0B45A"
  },
  "light": {
    "note": "Asher is dark-first. Light mode keeps the same hues on a cloud-white base.",
    "void": "#F4F7FA",
    "surface": "#FFFFFF",
    "surface-raised": "#EEF3F8",
    "border": "#D6DFE8",
    "text": "#0B1017",
    "text-secondary": "#4A5D70",
    "text-muted": "#8194A6",
    "bubble-in": "#EEF3F8",
    "bubble-in-border": "#D6DFE8"
  },
  "typography": {
    "display": { "family": "Space Grotesk, Inter, system-ui, sans-serif", "weight": 500, "tracking": "-0.02em" },
    "ui": { "family": "Inter, -apple-system, Roboto, system-ui, sans-serif", "weight": 400 },
    "mono": { "family": "JetBrains Mono, SF Mono, Roboto Mono, monospace" },
    "scale": {
      "display": { "size": 40, "line": 44 },
      "title": { "size": 22, "line": 28, "weight": 600, "tracking": "-0.01em" },
      "headline": { "size": 17, "line": 22, "weight": 600 },
      "body": { "size": 16, "line": 22 },
      "message": { "size": 16, "line": 21 },
      "caption": { "size": 13, "line": 18 },
      "micro": { "size": 11, "line": 14, "tracking": "0.04em", "transform": "uppercase" }
    },
    "mobile_note": "Android and iOS use the system font (Roboto / SF) with this scale and tracking; Desktop and web bundle Inter and Space Grotesk."
  },
  "spacing": {
    "unit": 4,
    "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48,
    "message-gap-same-sender": 2,
    "message-gap-new-sender": 12,
    "message-padding": "10px 14px",
    "bubble-max-width": "72%",
    "list-row-height": 72,
    "composer-height": 52,
    "gutter": 16,
    "reading-measure": "68ch",
    "rationale": "Generous vertical rhythm and a 72% bubble measure keep scanning effortless; tight 2px grouping of consecutive messages reads as one thought. Nothing shouts."
  },
  "radius": {
    "bubble": 18,
    "bubble-tail": 4,
    "bubble-grouped": 6,
    "card": 16,
    "control": 12,
    "pill": 999,
    "avatar": "circle"
  },
  "avatar": {
    "shape": "circle",
    "ring": { "width": 1.5, "gradient": "linear-gradient(135deg, #7FB8E0 0%, rgba(127,184,224,0) 70%)", "note": "the planet's limb: lit on one side, fading to void" },
    "sizes": { "message": 28, "header": 32, "list": 44, "compact": 36, "profile": 96, "hero": 160 },
    "fallback": { "background": "#1E466B", "foreground": "#CFE6F7", "font": "display" }
  },
  "bubble": {
    "outgoing": { "fill": "linear-gradient(160deg, #2A6FA8 0%, #1F5686 100%)", "text": "#F4F9FD", "radius": "18 18 4 18" },
    "incoming": { "fill": "#131C28", "border": "1px solid #1E2A3A", "text": "#E8EEF4", "radius": "18 18 18 4" },
    "grouped": "consecutive bubbles from one sender use radius 6 on the shared side",
    "meta": { "size": 11, "color": "#9BB0C3", "inside": true },
    "status_glyphs": { "sending": "hollow ring", "sent": "single tick", "delivered": "double tick", "read": "double tick in atmosphere blue", "carrying": "small orbit arc (mesh, waiting for a relay)" }
  },
  "composer": {
    "shape": "pill",
    "fill": "#111823",
    "border": "1px solid #1B2533",
    "focus-ring": "0 0 0 2px rgba(61,143,207,0.45)",
    "send-button": { "size": 36, "fill": "#3D8FCF", "icon": "#F4F9FD" },
    "attach": "a plus that rotates 45deg into a close on open"
  },
  "upload": {
    "dropzone": "dashed 1px #27344A on #0B1017, atmosphere-blue glow on drag-over",
    "thumbnail-radius": 12,
    "progress": "thin 2px arc around the thumbnail (orbit), atmosphere blue, 400ms ease-out per step",
    "max-preview-height": 240
  },
  "typing_indicator": {
    "dots": 3,
    "dot-size": 6,
    "gap": 4,
    "animation": "each dot rises 3px and brightens from text-muted to rim over 900ms, staggered 150ms, ease-in-out; loops",
    "container": "incoming bubble shape"
  },
  "scene_indicator": {
    "meaning": "A pill under the conversation title that says how the two of you are connected right now.",
    "states": {
      "orbit": { "label": "Orbit", "color": "#5AA7E0", "when": "internet reachable" },
      "mesh": { "label": "Mesh · N hops", "color": "#4FBF9F", "when": "peer reachable over radio" },
      "carrying": { "label": "Carrying", "color": "#E0B45A", "when": "queued, waiting for a relay" },
      "offline": { "label": "Out of range", "color": "#5F7387", "when": "nothing" }
    },
    "dot": "6px, soft 8px glow of the same colour, 2s breathing pulse when active"
  },
  "presence": { "dot-size": 10, "ring": "2px surface colour", "pulse": "2.4s ease-in-out infinite, opacity .6 to 1" },
  "motion": {
    "ease-out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "fast": 160, "base": 240, "slow": 400, "drift": 1200,
    "message-send": "bubble translates up 8px and fades 0 to 1 over 240ms ease-out; status glyph crossfades 160ms",
    "message-receive": "bubble scales 0.96 to 1 and fades over 240ms ease-out",
    "screen-transition": "slide 24px + fade, 240ms; pop uses 160ms",
    "sheet": "rises from bottom 400ms ease-out, dim to 60% void",
    "background-drift": "wallpaper translates 1.5% over 60s and back (parallax on scroll on web); disabled with reduce-motion",
    "reduce-motion": "respect the OS setting: crossfades only"
  },
  "notification": {
    "sound": "brands/asher/design/sounds/asher_notify.wav",
    "sent_sound": "brands/asher/design/sounds/asher_sent.wav",
    "vibration_ms": [0, 40, 60, 40],
    "vibration_urgent_ms": [0, 60, 80, 60, 80, 60],
    "ios_haptic": { "receive": "impact light", "send": "selection", "delivered": "none" },
    "banner": { "fill": "#111823", "border": "1px solid #1B2533", "accent": "#3D8FCF", "radius": 16 },
    "badge": "#3D8FCF on #05070B"
  },
  "components": {
    "button-primary": { "fill": "#3D8FCF", "text": "#F4F9FD", "radius": 12, "height": 44, "hover": "#5AA7E0", "pressed": "#2E74AB" },
    "button-secondary": { "fill": "transparent", "border": "1px solid #27344A", "text": "#E8EEF4", "hover-fill": "#111823" },
    "input": { "fill": "#0B1017", "border": "1px solid #1B2533", "radius": 12, "height": 44, "focus": "#3D8FCF" },
    "list-row": { "height": 72, "hover": "#0B1017", "selected": "#16202D", "divider": "none, use spacing" },
    "chip": { "fill": "#16202D", "text": "#9BB0C3", "radius": 999 },
    "toast": { "fill": "#16202D", "border": "1px solid #27344A", "radius": 12 },
    "shadow": "0 12px 40px rgba(0,0,0,0.55)",
    "glow": "0 0 24px rgba(61,143,207,0.25)"
  },
  "responsive": {
    "breakpoints": { "phone": 0, "tablet": 720, "desktop": 1080, "wide": 1440 },
    "conversation-list-width": { "tablet": 320, "desktop": 360, "wide": 400 },
    "touch-target": 44,
    "safe-area": "respect insets; wallpaper bleeds under status and nav bars"
  },
  "naming": { "app": "Asher", "tagline": "Talk from anywhere. Even nowhere.", "transport_names": { "internet": "Orbit", "mesh": "Mesh", "queued": "Carrying" } }
}
